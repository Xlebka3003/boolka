# Track only source, user documentation, licenses and reviewed screenshots.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/THIRD_PARTY_NOTICES.txt
!/DIAGNOSTICS.md
!/BACKUPS.md
!/PACKS.md
!/IMAGE_SOURCES.md
!/src/
!/docs/
/docs/*
!/docs/screenshots/
!/docs/releases/
!/.github/

**/bin/
**/obj/
**/.vs/
**/*.user
**/*.suo
**/*.pfx
**/*.snk
**/.env
**/logs/

# Исходники и проверки Windows/WPF, отдельные сторонние лицензии.
!/tests/
!/THIRD-PARTY/
/src/Boolka.Desktop/
/tests/Avalonia.Smoke/

# Установщик и инструкция Windows.
!/INSTALLING.md
!/UPDATING.md
!/installer/
!/scripts/
/scripts/*
!/scripts/Package-Windows.ps1
