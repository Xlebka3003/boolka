              <TextBlock x:Name="GitHubLabel" Text="GitHub" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button
            x:Name="SettingsButton"
            Click="OpenSettings"
            HorizontalAlignment="Left"
            Padding="0"
            Margin="0,0,0,12"
            AutomationProperties.Name="{DynamicResource Ui.985B5E0F2CCF1BA0}"
            Width="44"
            Height="44">
            <StackPanel Orientation="Horizontal">
              <local:LucideIcon Icon="settings" Width="32" Height="22" />
              <TextBlock x:Name="SettingsLabel" Text="{DynamicResource Ui.985B5E0F2CCF1BA0}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <StackPanel
            x:Name="SidebarFooter"
            Margin="4,0,0,0">
            <TextBlock
              Text="{DynamicResource Ui.205800635DB91E89}"
              Foreground="{DynamicResource Theme.B9A9F4}"
              FontSize="12" />
            <TextBlock
              Text="{DynamicResource Ui.85D153697A1B68F3}"
              Foreground="{DynamicResource Muted}"
              FontSize="12"
              Margin="0,8,0,0" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <Grid
      x:Name="ContentHost"
      Grid.Column="1"
      Background="Transparent"
      PreviewMouseWheel="DetailMouseWheel"
      PreviewMouseDown="PageMiddleDown"
      PreviewMouseMove="PageMiddleMove"
      PreviewMouseUp="PageMiddleUp"
      LostMouseCapture="PagePanLostCapture">
      <Grid
        Margin="32,30,32,24">
        <Grid.RowDefinitions>
          <RowDefinition
            Height="*" />
          <RowDefinition
            Height="Auto" />
        </Grid.RowDefinitions>
        <Grid
          x:Name="LibraryView">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="*" />
          </Grid.RowDefinitions>
          <Border
            Grid.Row="1"
            Background="{DynamicResource Theme.1B2030}"
            CornerRadius="{DynamicResource Theme.Radius12}"
            Padding="18"
            Margin="0,0,0,20">
            <DockPanel>
              <Button
                x:Name="ChooseFolderButton"
                DockPanel.Dock="Right"
                Content="{DynamicResource Ui.88D4B06D5629E51D}"
                Click="ChooseFolder"
                Background="Transparent"
                Foreground="{DynamicResource Theme.E9EDF5}"
                Margin="15,0,0,0" />
              <Button x:Name="OpenAddonsFolderButton" DockPanel.Dock="Right" Click="OpenAddonsFolder" Margin="12,0,0,0" />
              <StackPanel
                VerticalAlignment="Center">
                <TextBlock
                  Text="{DynamicResource Ui.8EF1F89A2D135E73}"
                  FontWeight="SemiBold" />
