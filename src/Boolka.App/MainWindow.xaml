<?xml version="1.0" encoding="utf-8"?>
<Window
  Icon="Assets/boolka.ico"
  x:Class="Boolka.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Boolka"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  WindowStyle="None"
  Title="boolka"
  Width="1280"
  Height="840"
  FontSize="14"
  MinWidth="840"
  MinHeight="560"
  Background="{DynamicResource Theme.10131B}"
  WindowStartupLocation="CenterScreen"
  UseLayoutRounding="True"
  SnapsToDevicePixels="True"
  PreviewKeyDown="WindowKeyDown"
  PreviewMouseLeftButtonDown="ClearSelectionOnBackground"
  PreviewMouseRightButtonUp="WindowRightMouseUp">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" CornerRadius="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="FilterItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="BorderThickness" Value="0" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="FilterBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="ItemContainerStyle" Value="{StaticResource FilterItem}" />
      <Setter Property="AlternationCount" Value="2147483647" />
    </Style>
    <DataTemplate x:Key="PreviousIconTemplate"><local:LucideIcon Icon="arrow-left" /></DataTemplate>
    <DataTemplate x:Key="NextIconTemplate"><local:LucideIcon Icon="arrow-right" /></DataTemplate>
    <DataTemplate x:Key="BackIconTemplate"><StackPanel Orientation="Horizontal"><local:LucideIcon Icon="arrow-left" Margin="0,0,8,0" /><TextBlock Text="{Binding}" VerticalAlignment="Center" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="ForwardIconTemplate"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" VerticalAlignment="Center" /><local:LucideIcon Icon="arrow-right" Margin="8,0,0,0" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="ExternalIconTemplate"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding}" VerticalAlignment="Center" /><local:LucideIcon Icon="external-link" Width="16" Height="16" Margin="8,0,0,0" /></StackPanel></DataTemplate>
    <DataTemplate x:Key="CloseIconTemplate"><StackPanel Orientation="Horizontal"><local:LucideIcon Icon="x" Margin="0,0,8,0" /><TextBlock Text="{Binding}" VerticalAlignment="Center" /></StackPanel></DataTemplate>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="46" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="12" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Theme.353044}" /></Trigger></Style.Triggers>
    </Style>
    <DataTemplate
      x:Key="AddonListTemplate">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="92"
            x:Name="PreviewColumn" />
          <ColumnDefinition
            Width="*" />
          <ColumnDefinition
            Width="Auto" />
        </Grid.ColumnDefinitions>
        <local:PreviewThumbnail
          Cursor="Hand"
          AddonId="{Binding PreviewId}" CategoryId="{Binding DisplayCategoryId}"
          Width="76"
          Height="76"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          x:Name="RowPreview" />
        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center">
          <TextBlock
            Cursor="Hand"
            Text="{Binding DisplayName}"
            FontSize="19"
            FontWeight="SemiBold"
            TextTrimming="CharacterEllipsis"
            x:Name="RowTitle" />
          <TextBlock
            Text="{Binding Author}"
            Foreground="{DynamicResource Muted}"
            FontSize="14"
            Margin="0,6,0,0"
            TextTrimming="CharacterEllipsis"
            x:Name="RowAuthor" />
          <TextBlock
            Foreground="{DynamicResource Muted}"
            FontSize="14"
            Margin="0,10,0,0"
            TextWrapping="Wrap"
            x:Name="RowStats">
            <Run
              Text="↓ "
              Foreground="{DynamicResource Theme.7DDDC0}"
              FontWeight="SemiBold" />
            <Run
              Text="{Binding DownloadsText, Mode=OneWay}"
              Foreground="{DynamicResource Theme.7DDDC0}"
              FontWeight="SemiBold" />
            <Run
              Text="{DynamicResource Ui.920F6423E90DBB86}" />
            <Run
              Text="{Binding UpdatedText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock
            x:Name="RowDependencyStatus"
            Text="{Binding DependencyStatusText}"
            Foreground="{Binding DependencyStatusColor}"
            FontSize="14"
            FontWeight="SemiBold"
            TextWrapping="Wrap"
            Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel
          Grid.Column="2"
          Margin="12,0,0,0"
          MaxWidth="150"
          VerticalAlignment="Center">
          <TextBlock
            Text="{Binding VersionLabel}"
            FontSize="16"
            Foreground="{DynamicResource Theme.C8B7FF}"
            TextTrimming="CharacterEllipsis"
            HorizontalAlignment="Right"
            x:Name="RowVersion" />
          <Button
            Content="{Binding InstallationLabel}"
            Click="InstallAddon"
            IsEnabled="{Binding CanInstall}"
            FontSize="14"
            FontWeight="SemiBold"
             Background="{Binding InstallActionBackground}"
            Foreground="{Binding InstallActionForeground}"
            Padding="16,9"
            MinWidth="116"
            HorizontalAlignment="Right"
            Margin="0,10,0,0"
            x:Name="RowInstall" Tag="AddonInstallAction">
            <Button.ContentTemplate>
              <DataTemplate>
                <TextBlock
                  Text="{Binding}"
                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                  FontWeight="SemiBold" />
              </DataTemplate>
            </Button.ContentTemplate>
          </Button>
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger
          Binding="{Binding DependencyStatusText}"
          Value="">
          <Setter
            TargetName="RowDependencyStatus"
            Property="Visibility"
            Value="Collapsed" />
        </DataTrigger>
        <DataTrigger
          Binding="{Binding CompactRows, RelativeSource={RelativeSource AncestorType=Window}}"
          Value="True">
          <Setter
            TargetName="PreviewColumn"
            Property="Width"
            Value="56" />
          <Setter
            TargetName="RowPreview"
            Property="Width"
            Value="40" />
          <Setter
            TargetName="RowPreview"
            Property="Height"
            Value="40" />
          <Setter
            TargetName="RowTitle"
            Property="FontSize"
            Value="16" />
          <Setter
            TargetName="RowAuthor"
            Property="Visibility"
            Value="Collapsed" />
          <Setter
            TargetName="RowStats"
            Property="FontSize"
            Value="12" />
          <Setter
            TargetName="RowStats"
            Property="Margin"
            Value="0,4,0,0" />
          <Setter
            TargetName="RowDependencyStatus"
            Property="Visibility"
            Value="Collapsed" />
          <Setter
            TargetName="RowVersion"
            Property="FontSize"
            Value="13" />
          <Setter
            TargetName="RowInstall"
            Property="FontSize"
            Value="12" />
          <Setter
            TargetName="RowInstall"
            Property="Padding"
            Value="12,6" />
          <Setter
            TargetName="RowInstall"
            Property="MinWidth"
            Value="100" />
          <Setter
            TargetName="RowInstall"
            Property="Margin"
            Value="0,4,0,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="AddonTilesTemplate">
      <Grid Background="Transparent" ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="80" />
          <RowDefinition Height="48" />
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
          <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <local:PreviewThumbnail AddonId="{Binding PreviewId}" CategoryId="{Binding DisplayCategoryId}" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Top" />
        <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,4,0,0" />
        <StackPanel Grid.Row="2" Margin="0,4,0,0">
          <TextBlock FontSize="13" Foreground="{DynamicResource Theme.7DDDC0}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="↓ " /><Run Text="{Binding DownloadsText, Mode=OneWay}" /></TextBlock>
          <TextBlock Text="{Binding UpdatedText}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" />
        </StackPanel>
        <TextBlock x:Name="TileHealth" Grid.Row="3" Text="{Binding DependencyStatusText}" Foreground="{Binding DependencyStatusColor}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button x:Name="TileInstall"  Grid.Row="4" Content="{Binding InstallationLabel}" IsEnabled="{Binding CanInstall}" Click="InstallAddon" Padding="8,6" VerticalAlignment="Bottom" Tag="AddonInstallAction" Background="{Binding InstallActionBackground}" Foreground="{Binding InstallActionForeground}" FontSize="13" FontWeight="SemiBold" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DependencyStatusText}" Value=""><Setter TargetName="TileHealth" Property="Visibility" Value="Collapsed" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <ItemsPanelTemplate
      x:Key="AddonCompactPanel">
      <VirtualizingStackPanel />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate
      x:Key="AddonTilesPanel">
      <local:AdaptiveTilePanel
        TileHeight="280" PreferredColumns="{DynamicResource Collection.TileColumns}" />
    </ItemsPanelTemplate>
  </Window.Resources>
  <DockPanel Background="{DynamicResource Theme.10131B}">
    <Border x:Name="TitleBarSurface" DockPanel.Dock="Top" Height="36" Background="{DynamicResource Theme.10131B}">
      <Grid>
        <Border x:Name="SidebarCaptionBackground" HorizontalAlignment="Left" Width="76" Background="{DynamicResource Theme.151923}" BorderBrush="{DynamicResource Theme.252A36}" BorderThickness="0,0,1,0" />
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="MinimizeCaptionButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="{DynamicResource Ui.0F0CEC10ABAC3795}" ><local:LucideIcon Icon="minus" Width="16" Height="16" /></Button>
          <Button x:Name="MaximizeCaptionButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow" AutomationProperties.Name="{DynamicResource Ui.59C7F54BB0F7F61B}" ><local:LucideIcon x:Name="MaximizeCaptionIcon" Icon="square" Width="16" Height="16" /></Button>
          <Button x:Name="CloseCaptionButton" Click="CloseWindow" AutomationProperties.Name="{DynamicResource Ui.DB9CC7B22FFDF323}">
            <local:LucideIcon Icon="x" Width="18" Height="18" />
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers></Style></Button.Style>
          </Button>
        </StackPanel>
        <TextBlock Text="boolka" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Theme.E9EDF5}" />
      </DockPanel>
      </Grid>
    </Border>
  <Grid
    Background="{DynamicResource Theme.10131B}">
    <Grid.LayoutTransform>
      <ScaleTransform
        x:Name="InterfaceScale"
        ScaleX="1"
        ScaleY="1" />
    </Grid.LayoutTransform>
    <Grid.ColumnDefinitions>
      <ColumnDefinition
        Width="218"
        x:Name="SidebarColumn" />
      <ColumnDefinition
        Width="*" />
    </Grid.ColumnDefinitions>
    <Border
      x:Name="SidebarSurface" Background="{DynamicResource Theme.151923}"
      BorderBrush="{DynamicResource Theme.252A36}"
      BorderThickness="0,0,1,0">
      <Grid
        Margin="12,22">
        <Grid.RowDefinitions>
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="*" />
          <RowDefinition
            Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="SidebarBrand"
              Text="boolka"
              FontSize="28"
              FontWeight="SemiBold"
              VerticalAlignment="Center" />
            <Button
              x:Name="SidebarToggle"
              Grid.Column="1"
              Content=""
              Click="ToggleSidebar"
              FontSize="24"
              Width="44"
              Height="44"
              Padding="0"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              AutomationProperties.Name="{DynamicResource Ui.0AE08BBD61B7D588}" />
          </Grid>
          <TextBlock
            x:Name="SidebarTagline"
            Text="{DynamicResource Ui.36EFC5F2DEF4E110}"
            FontSize="10"
            Foreground="{DynamicResource Muted}"
            Margin="4,12,0,28" />
        </StackPanel>
        <StackPanel
          Grid.Row="1"
          Margin="0,22,0,0">
          <TextBlock
            x:Name="SidebarLibraryLabel"
            Text="{DynamicResource Ui.C4AEC74A0FF6F9CD}"
            FontSize="12"
            Foreground="{DynamicResource Muted}"
            Margin="4,0,0,12" />
          <Button
            x:Name="EsoGameButton"
            Height="44"
            Click="ShowEsoLibrary"
            Background="{DynamicResource Theme.29253B}"
            Padding="8,0"
            VerticalContentAlignment="Center"
            HorizontalContentAlignment="Left"
            AutomationProperties.Name="The Elder Scrolls Online">
            <StackPanel
              Orientation="Horizontal">
              <Image
                Source="Assets/eso.ico"
                Width="32"
                Height="32"
                RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock
                x:Name="EsoGameLabel"
                Text="The Elder Scrolls&#xA;Online"
                FontWeight="SemiBold"
                Margin="12,0,0,0"
                VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock
            x:Name="SidebarOtherLabel"
            Text="{DynamicResource Ui.9ACB7BA1936D120E}"
            FontSize="12"
            Foreground="{DynamicResource Muted}"
            Margin="4,28,0,12" />
          <Button
            x:Name="WowGameButton"
            Visibility="Collapsed"
            Height="64"
            Margin="0,8,0,0"
            Click="ShowWowComingSoon"
            Background="Transparent"
            Padding="8,0"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            AutomationProperties.Name="{DynamicResource Ui.37F838EA836C677B}">
            <StackPanel
              Orientation="Horizontal">
              <Image
                Source="Assets/wow.ico"
                Width="32"
                Height="32"
                RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel
                x:Name="WowGameLabel"
                Margin="12,0,0,0"
                VerticalAlignment="Center">
                <TextBlock
                  Text="World of Warcraft"
                  Foreground="{DynamicResource Muted}" />
                <TextBlock
                  Text="{DynamicResource Ui.7996F711496A5424}"
                  Foreground="{DynamicResource Theme.737D90}"
                  FontSize="12"
                  Margin="0,3,0,0" />
              </StackPanel>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel
          Grid.Row="2" Height="348">
          <Button x:Name="LaunchButton" Foreground="{DynamicResource Theme.7DDDC0}" Height="44" Padding="0" Margin="0,0,0,8" Click="LaunchEso" AutomationProperties.Name="Launch ESO">
            <Button.ContextMenu><ContextMenu><MenuItem Header="ESO launch settings" Click="ConfigureLaunch" /></ContextMenu></Button.ContextMenu>
            <StackPanel Orientation="Horizontal"><local:LucideIcon Icon="play" Width="32" Height="22" /><TextBlock x:Name="LaunchLabel" Text="ESO" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="SupportButton" Height="44" Padding="0" Margin="0,0,0,8" Foreground="#FF79C6"
                  Click="OpenDonation" AutomationProperties.Name="{DynamicResource Ui.3B024CCE3B598E9A}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1FFF79C6" /></Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <local:LucideIcon Icon="heart" Width="32" Height="22" />
              <TextBlock x:Name="SupportLabel" Text="{DynamicResource Ui.0A3173E3188C6979}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AppUpdateButton" Height="44" Padding="0" Margin="0,0,0,8" IsEnabled="False" Click="UpdateApplication" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="{DynamicResource Ui.B22AE3D8FB8F72DD}" AutomationProperties.HelpText="{DynamicResource Ui.60395C6C8515CE22}">
            <StackPanel Orientation="Horizontal">
              <local:LucideIcon Icon="refresh-cw" Width="32" Height="22" />
              <TextBlock x:Name="AppUpdateLabel" Text="{DynamicResource Ui.B22AE3D8FB8F72DD}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="GitHubButton" Height="44" Padding="0" Margin="0,0,0,8" Click="OpenGitHub" AutomationProperties.Name="GitHub">
